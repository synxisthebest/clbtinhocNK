# ==========================================
# CẤU HÌNH GỬI EMAIL TỰ ĐỘNG CHO BAN CHỦ NHIỆM
# ==========================================
# 1. Email nhận thông báo hồ sơ ứng viên:
CLUB_GMAIL=nkdeveloperclub@gmail.com

# 2. Cấu hình gửi mail thực tế qua SMTP Gmail (Khuyên dùng để thư vào thẳng Inbox):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nkdeveloperclub@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Hướng dẫn tạo SMTP_PASS (Mật khẩu ứng dụng Gmail 16 chữ số):
# 1. Mở https://myaccount.google.com/security
# 2. Bật "Xác minh 2 bước" (2-Step Verification)
# 3. Mở https://myaccount.google.com/apppasswords
# 4. Đặt tên ứng dụng: "Recruitment Portal" -> Nhấn Tạo
# 5. Copy 16 ký tự mật khẩu dán vào SMTP_PASS ở trên.

# 3. (Tùy chọn) Web3Forms Access Key:
# WEB3FORMS_ACCESS_KEY=your_access_key_here

# 4. Google Gemini AI API Key (Chấm điểm hồ sơ tự động):
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000
